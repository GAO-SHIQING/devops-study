      "# 综合练习 3：每月销售报告",
      "!docker exec pg-learn psql -U postgres -d learn -c \"",
      "WITH monthly AS (",
      "    SELECT",
      "        DATE_TRUNC('month', s.sale_date)::date AS month,",
      "        COUNT(DISTINCT s.id) AS 订单数,",
      "        SUM(s.quantity) AS 销售量,",
      "        SUM(s.quantity * b.price) AS 销售额",
      "    FROM bookstore.sales s",
      "    JOIN bookstore.books b ON s.book_id = b.id",
      "    GROUP BY DATE_TRUNC('month', s.sale_date)",
      ")",
      "SELECT",
      "    month AS 月份,",
      "    订单数,",
      "    销售量,",
      "    ROUND(销售额, 2) AS 销售额,",
      "    LAG(ROUND(销售额, 2)) OVER (ORDER BY month) AS 上月销售额,",
      "    CASE",
      "        WHEN LAG(销售额) OVER (ORDER BY month) IS NULL THEN NULL",
      "        ELSE ROUND((销售额 - LAG(销售额) OVER (ORDER BY month)) / NULLIF(LAG(销售额) OVER (ORDER BY month), 0) * 100, 1)",
      "    END AS 环比增长率",
      "FROM monthly",
      "ORDER BY month;",
      "\""
    ]
  },
