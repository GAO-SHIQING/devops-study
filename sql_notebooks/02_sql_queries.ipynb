      "# 综合练习 5：用递归 CTE 生成 2024 年每个月的日历",
      "!docker exec pg-learn psql -U postgres -d learn -c \"",
      "WITH RECURSIVE dates(d) AS (",
      "    SELECT '2024-01-01'::date",
      "    UNION ALL",
      "    SELECT d + 1 FROM dates WHERE d < '2024-12-31'",
      ")",
      "SELECT",
      "    EXTRACT(YEAR FROM d)::int AS year,",
      "    EXTRACT(MONTH FROM d)::int AS month,",
      "    EXTRACT(WEEK FROM d)::int AS week,",
      "    EXTRACT(DOW FROM d)::int AS day_of_week,",
      "    COUNT(*) AS days_in_month",
      "FROM dates",
      "GROUP BY EXTRACT(YEAR FROM d), EXTRACT(MONTH FROM d)",
      "ORDER BY year, month;",
      "\"",
      "",
      "print(\"注意：这个查询生成了 365 行然后做了聚合，在真实场景中注意性能\")"
    ]
