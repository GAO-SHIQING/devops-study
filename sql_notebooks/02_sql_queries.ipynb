      "# 综合练习 2：每位顾客的总花费和等级",
      "!docker exec pg-learn psql -U postgres -d learn -c \"",
      "SELECT c.name AS 顾客, c.level AS 等级,",
      "       COUNT(DISTINCT s.id) AS 订单数,",
      "       SUM(s.quantity) AS 购买总数量,",
      "       SUM(s.quantity * b.price) AS 总花费,",
      "       RANK() OVER (ORDER BY SUM(s.quantity * b.price) DESC) AS 消费排名",
      "FROM bookstore.customers c",
      "JOIN bookstore.sales s ON c.id = s.customer_id",
      "JOIN bookstore.books b ON s.book_id = b.id",
      "GROUP BY c.id, c.name, c.level",
      "ORDER BY 总花费 DESC;",
