      "# 综合练习 1：每月销售额排名前 3 的书籍",
      "!docker exec pg-learn psql -U postgres -d learn -c \"",
      "WITH monthly_sales AS (",
      "    SELECT",
      "        DATE_TRUNC('month', s.sale_date)::date AS month,",
      "        b.title,",
      "        SUM(s.quantity * b.price) AS revenue",
      "    FROM bookstore.sales s",
      "    JOIN bookstore.books b ON s.book_id = b.id",
      "    GROUP BY DATE_TRUNC('month', s.sale_date), b.title",
      "),",
      "ranked AS (",
      "    SELECT month, title, revenue,",
      "           ROW_NUMBER() OVER (PARTITION BY month ORDER BY revenue DESC) AS rn",
      "    FROM monthly_sales",
      ")",
      "SELECT month, title, ROUND(revenue, 2) AS 销售额",
      "FROM ranked",
