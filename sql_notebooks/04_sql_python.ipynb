      "# 业务查询 2：下单流程（事务：锁库存 -> 创建订单 -> 清空购物车）",
      "from datetime import datetime",
      "",
      "session = Session(engine)",
      "",
      "def place_order(user_id, sku_id, quantity):",
      "    \"\"\"下单事务\"\"\"",
      "    try:",
      "        sku = session.query(SKU).filter_by(id=sku_id).with_for_update().first()",
      "        if not sku or sku.stock < quantity:",
      "            return {\"status\": \"failed\", \"reason\": \"库存不足\"}",
      "",
      "        sku.stock -= quantity",
      "",
      "        order = Order(",
      "            user_id=user_id,",
      "            total=float(sku.price) * quantity,",
      "            status=\"pending\"",
      "        )",
      "        session.add(order)",
      "        session.flush()",
      "",
      "        item = OrderItem(",
      "            order_id=order.id,",
      "            sku_id=sku_id,",
      "            quantity=quantity,",
      "            price=sku.price",
      "        )",
      "        session.add(item)",
      "",
      "        session.commit()",
      "        return {\"status\": \"success\", \"order_id\": order.id, \"total\": float(order.total)}",
      "",
      "    except Exception as e:",
      "        session.rollback()",
      "        return {\"status\": \"failed\", \"reason\": str(e)}",
      "",
      "",
      "# 测试下单",
      "result = place_order(user_id=1, sku_id=1, quantity=1)",
      "print(f\"下单结果: {result}\")",
      "",
      "# 验证库存",
      "sku = session.query(SKU).filter_by(id=1).first()",
      "print(f\"iPhone 16 256GB 剩余库存: {sku.stock}\")",
      "",
      "session.close()"
    ]
  },
