    "cell_type": "code",
    "source": [
      "# 业务查询 3：销售统计",
      "session = Session(engine)",
      "",
      "print(\"=== 商品销售统计 === \")",
      "from sqlalchemy import func",
      "stats = session.query(",
      "    Product.name,",
      "    func.sum(OrderItem.quantity).label(\"total_sold\"),",
      "    func.sum(OrderItem.quantity * OrderItem.price).label(\"total_revenue\")",
      ").select_from(OrderItem)",
      "stats = stats.join(SKU, OrderItem.sku_id == SKU.id)",
      "stats = stats.join(Product, SKU.product_id == Product.id)",
      "stats = stats.join(Order, OrderItem.order_id == Order.id)",
      "stats = stats.filter(Order.status != 'cancelled')",
      "stats = stats.group_by(Product.id, Product.name)",
      "stats = stats.order_by(func.sum(OrderItem.quantity).desc())",
      "",
      "for s in stats:",
      "    print(f\"  {s.name}: 销量 {s.total_sold}, 收入 ¥{float(s.total_revenue):.2f}\")",
      "",
      "session.close()"
    ]
  },
