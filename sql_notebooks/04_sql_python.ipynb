      "# Day 22 练习：用 psycopg2 操作数据库",
      "",
      "import psycopg2",
      "",
      "# 建立连接",
      "conn = psycopg2.connect(",
      "    host=\"localhost\",",
      "    port=5432,",
      "    dbname=\"learn\",",
      "    user=\"postgres\",",
      "    password=\"secret\"",
      ")",
      "",
      "print(\"连接成功！\")",
      "",
      "# 获取服务器版本",
      "with conn.cursor() as cur:",
      "    cur.execute(\"SELECT version();\")",
      "    print(f\"PG 版本: {cur.fetchone()[0]}\")",
      "",
      "# 查询数据",
      "with conn.cursor() as cur:",
      "    cur.execute(\"\"\"",
      "        SELECT b.title, a.name AS author, b.price",
      "        FROM bookstore.books b",
      "        JOIN bookstore.authors a ON b.author_id = a.id",
      "        ORDER BY b.price DESC",
      "        LIMIT 5",
      "    \"\"\")",
      "    print(\"\\n=== 最贵的 5 本书 === \")",
      "    for row in cur.fetchall():",
      "        print(f\"  {row[0]} — {row[1]} — ¥{row[2]}\")"
    ]
