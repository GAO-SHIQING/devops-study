      "# 业务查询 1：商品搜索（多条件 + 分页）",
      "from sqlalchemy import or_, and_",
      "",
      "session = Session(engine)",
      "",
      "def search_products(keyword=None, category_name=None, min_price=None, max_price=None, page=1, page_size=10):",
      "    \"\"\"商品搜索函数\"\"\"",
      "    query = session.query(",
      "        Product.id, Product.name,",
      "        Category.name.label(\"category\"),",
      "        SKU.price, SKU.stock, SKU.specs",
      "    ).join(Category, Product.category_id == Category.id)",
      "",
      "    query = query.join(SKU, Product.id == SKU.product_id)",
      "    query = query.distinct(Product.id)",
      "",
      "    if keyword:",
      "        query = query.filter(Product.name.ilike(f\"%{keyword}%\"))",
      "    if category_name:",
      "        query = query.filter(Category.name == category_name)",
      "    if min_price is not None:",
      "        query = query.filter(SKU.price >= min_price)",
      "    if max_price is not None:",
      "        query = query.filter(SKU.price <= max_price)",
      "",
      "    offset = (page - 1) * page_size",
      "    query = query.order_by(Product.id).offset(offset).limit(page_size)",
      "",
      "    return query.all()",
      "",
      "",
      "# 测试搜索",
      "results = search_products(category_name=\"电子产品\", page=1, page_size=5)",
      "print(\"=== 电子产品搜索 === \")",
      "for r in results:",
      "    print(f\"  {r.name} — ¥{r.price} (库存: {r.stock})\")",
      "",
      "print(\"\\n---\")",
      "results2 = search_products(keyword=\"Nike\")",
      "print(\"=== 搜索 Nike === \")",
      "for r in results2:",
      "    print(f\"  {r.name} — ¥{r.price}\")",
      "",
      "session.close()"
    ]
