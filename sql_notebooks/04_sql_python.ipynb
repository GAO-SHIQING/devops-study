    "source": [
      "# 用 Docker Compose 编排带自动备份的 PostgreSQL",
      "",
      "%%writefile /tmp/docker-compose-pg.yml",
      "services:",
      "  db:",
      "    image: postgres:16-alpine",
      "    environment:",
      "      POSTGRES_PASSWORD: secret",
      "      POSTGRES_DB: learn",
      "    ports:",
      "      - \"5432:5432\"",
      "    volumes:",
      "      - pgdata:/var/lib/postgresql/data",
      "    healthcheck:",
      "      test: [\"CMD-SHELL\", \"pg_isready -U postgres\"]",
      "      interval: 10s",
      "      timeout: 5s",
      "      retries: 5",
      "",
      "  backup:",
      "    image: postgres:16-alpine",
      "    entrypoint: [\"/bin/sh\", \"-c\"]",
      "    command:",
      "      - |",
      "        echo \"Waiting for db...\"",
      "        sleep 10",
      "        while true; do",
      "          filename=\"/backups/backup_$$(date +%Y%m%d_%H%M%S).sql\"",
      "          PGPASSWORD=secret pg_dump -h db -U postgres learn > \"$$filename\"",
      "          echo \"Backup done: $$filename\"",
      "          sleep 3600",
      "        done",
      "    volumes:",
      "      - ./backups:/backups",
      "    depends_on:",
      "      db:",
      "        condition: service_healthy",
      "",
      "volumes:",
      "  pgdata:",
      "",
      "print(\"docker-compose-pg.yml 已创建\")"
    ]
  },
