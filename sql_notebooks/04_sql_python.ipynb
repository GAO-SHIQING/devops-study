    "cell_id": "cell-28",
    "cell_type": "code",
    "source": [
      "# 定义所有 ORM 模型",
      "",
      "from sqlalchemy import (",
      "    create_engine, Column, Integer, String, Float, Text, Boolean,",
      "    ForeignKey, DateTime, DECIMAL, JSON, Index",
      ")",
      "from sqlalchemy.orm import DeclarativeBase, relationship, Session",
      "from datetime import datetime",
      "import enum",
      "",
      "engine = create_engine(",
      "    \"postgresql+psycopg2://postgres:secret@localhost:5432/learn\",",
      "    echo=False",
      ")",
      "",
      "class Base(DeclarativeBase):",
      "    pass",
      "",
      "# ========== 商品模块 ==========",
      "",
      "class Category(Base):",
      "    \"\"\"商品分类\"\"\"",
      "    __tablename__ = \"categories\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    name = Column(String(100), nullable=False, unique=True)",
      "    parent_id = Column(Integer, ForeignKey(\"mall.categories.id\"), nullable=True)",
      "    sort_order = Column(Integer, default=0)",
      "",
      "    children = relationship(\"Category\", backref=\"parent\", remote_side=[id])",
      "    products = relationship(\"Product\", back_populates=\"category\")",
      "",
      "",
      "class Brand(Base):",
      "    \"\"\"品牌\"\"\"",
      "    __tablename__ = \"brands\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    name = Column(String(200), nullable=False, unique=True)",
      "    logo_url = Column(Text)",
      "",
      "    products = relationship(\"Product\", back_populates=\"brand\")",
      "",
      "",
      "class Product(Base):",
      "    \"\"\"商品（SPU）\"\"\"",
      "    __tablename__ = \"products\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    name = Column(String(300), nullable=False)",
      "    description = Column(Text)",
      "    category_id = Column(Integer, ForeignKey(\"mall.categories.id\"), nullable=False)",
      "    brand_id = Column(Integer, ForeignKey(\"mall.brands.id\"), nullable=True)",
      "    created_at = Column(DateTime, default=datetime.now)",
      "",
      "    category = relationship(\"Category\", back_populates=\"products\")",
      "    brand = relationship(\"Brand\", back_populates=\"products\")",
      "    skus = relationship(\"SKU\", back_populates=\"product\", cascade=\"all, delete-orphan\")",
      "",
      "",
      "class SKU(Base):",
      "    \"\"\"SKU（库存量单位 — 商品规格变体）\"\"\"",
      "    __tablename__ = \"skus\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    product_id = Column(Integer, ForeignKey(\"mall.products.id\"), nullable=False)",
      "    name = Column(String(200))",
      "    price = Column(DECIMAL(10, 2), nullable=False)",
      "    stock = Column(Integer, nullable=False, default=0)",
      "    specs = Column(JSON)",
      "",
      "    product = relationship(\"Product\", back_populates=\"skus\")",
      "    cart_items = relationship(\"CartItem\", back_populates=\"sku\")",
      "    order_items = relationship(\"OrderItem\", back_populates=\"sku\")",
      "",
      "    __table_args__ = (",
      "        Index(\"idx_sku_product\", \"product_id\"),",
      "        {\"schema\": \"mall\"}",
      "    )",
      "",
      "",
      "# ========== 用户模块 ==========",
      "",
      "class User(Base):",
      "    __tablename__ = \"users\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    username = Column(String(100), nullable=False, unique=True)",
      "    email = Column(String(255), unique=True)",
      "    phone = Column(String(20))",
      "    password_hash = Column(String(255), nullable=False)",
      "    level = Column(String(20), default=\"普通\")",
      "    created_at = Column(DateTime, default=datetime.now)",
      "",
      "    addresses = relationship(\"Address\", back_populates=\"user\", cascade=\"all, delete-orphan\")",
      "    cart_items = relationship(\"CartItem\", back_populates=\"user\", cascade=\"all, delete-orphan\")",
      "    orders = relationship(\"Order\", back_populates=\"user\")",
      "",
      "",
      "class Address(Base):",
      "    __tablename__ = \"addresses\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    user_id = Column(Integer, ForeignKey(\"mall.users.id\"), nullable=False)",
      "    receiver = Column(String(100), nullable=False)",
      "    phone = Column(String(20), nullable=False)",
      "    province = Column(String(50))",
      "    city = Column(String(50))",
      "    district = Column(String(50))",
      "    detail = Column(String(500), nullable=False)",
      "    is_default = Column(Boolean, default=False)",
      "",
      "    user = relationship(\"User\", back_populates=\"addresses\")",
      "",
      "",
      "# ========== 购物车 ==========",
      "",
      "class CartItem(Base):",
      "    __tablename__ = \"cart_items\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    user_id = Column(Integer, ForeignKey(\"mall.users.id\"), nullable=False)",
      "    sku_id = Column(Integer, ForeignKey(\"mall.skus.id\"), nullable=False)",
      "    quantity = Column(Integer, nullable=False, default=1)",
      "    created_at = Column(DateTime, default=datetime.now)",
      "",
      "    user = relationship(\"User\", back_populates=\"cart_items\")",
      "    sku = relationship(\"SKU\", back_populates=\"cart_items\")",
      "",
      "",
      "# ========== 订单模块 ==========",
      "",
      "class Order(Base):",
      "    __tablename__ = \"orders\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    user_id = Column(Integer, ForeignKey(\"mall.users.id\"), nullable=False)",
      "    total = Column(DECIMAL(12, 2), nullable=False)",
      "    status = Column(String(20), default=\"pending\")",
      "    address_snapshot = Column(JSON)",
      "    created_at = Column(DateTime, default=datetime.now)",
      "    paid_at = Column(DateTime, nullable=True)",
      "",
      "    user = relationship(\"User\", back_populates=\"orders\")",
      "    items = relationship(\"OrderItem\", back_populates=\"order\", cascade=\"all, delete-orphan\")",
      "",
      "",
      "class OrderItem(Base):",
      "    __tablename__ = \"order_items\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    order_id = Column(Integer, ForeignKey(\"mall.orders.id\"), nullable=False)",
      "    sku_id = Column(Integer, ForeignKey(\"mall.skus.id\"), nullable=False)",
      "    quantity = Column(Integer, nullable=False)",
      "    price = Column(DECIMAL(10, 2), nullable=False)",
      "",
      "    order = relationship(\"Order\", back_populates=\"items\")",
      "    sku = relationship(\"SKU\", back_populates=\"order_items\")",
      "",
      "",
      "# ========== 评价模块 ==========",
      "",
      "class Review(Base):",
      "    __tablename__ = \"reviews\"",
      "    __table_args__ = {\"schema\": \"mall\"}",
      "",
      "    id = Column(Integer, primary_key=True)",
      "    user_id = Column(Integer, ForeignKey(\"mall.users.id\"), nullable=False)",
      "    product_id = Column(Integer, ForeignKey(\"mall.products.id\"), nullable=False)",
      "    order_id = Column(Integer, ForeignKey(\"mall.orders.id\"), nullable=False)",
      "    rating = Column(Integer, nullable=False)",
      "    content = Column(Text)",
      "    images = Column(JSON)",
      "    created_at = Column(DateTime, default=datetime.now)",
      "",
      "",
      "# 创建所有表",
      "Base.metadata.create_all(engine)",
      "print(\"所有电商表创建成功！\")",
      "print(\"\\n表列表:\")",
      "for table in Base.metadata.tables:",
      "    print(f\"  - {table}\")"
    ]
  },
