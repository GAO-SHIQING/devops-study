      "# 事务处理：用 with conn 自动管理事务",
      "",
      "def create_order(customer_id, book_id, quantity):",
      "    \"\"\"创建订单（事务：扣库存 + 创建销售记录）\"\"\"",
      "    try:",
      "        with conn:",
      "            with conn.cursor() as cur:",
      "                # 1. 扣库存",
      "                cur.execute(\"\"\"",
      "                    UPDATE bookstore.books",
      "                    SET stock = stock - %s",
      "                    WHERE id = %s AND stock >= %s",
      "                \"\"\", (quantity, book_id, quantity))",
      "",
      "                if cur.rowcount == 0:",
      "                    raise Exception(\"库存不足或书籍不存在\")",
      "",
      "                # 2. 获取当前价格",
      "                cur.execute(\"SELECT price FROM bookstore.books WHERE id = %s\", (book_id,))",
      "                price = cur.fetchone()[0]",
      "",
      "                # 3. 创建销售记录",
      "                cur.execute(\"\"\"",
      "                    INSERT INTO bookstore.sales (book_id, customer_id, quantity, sale_date)",
      "                    VALUES (%s, %s, %s, NOW())",
      "                    RETURNING id",
      "                \"\"\", (book_id, customer_id, quantity))",
      "",
      "                sale_id = cur.fetchone()[0]",
      "                total = float(price) * quantity",
      "",
      "        return {\"sale_id\": sale_id, \"total\": float(total), \"status\": \"成功\"}",
      "",
      "    except Exception as e:",
      "        return {\"status\": \"失败\", \"error\": str(e)}",
      "",
      "",
      "# 测试：小明买 1 本《Clean Code》",
      "result = create_order(customer_id=1, book_id=9, quantity=1)",
      "print(f\"下单结果: {result}\")",
      "",
      "# 验证库存",
