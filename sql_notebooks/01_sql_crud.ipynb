    "cell_type": "code",
    "source": [
      "# 5. 查询销售额最高的 3 本书\n",
      "# 注意：这里要用到计算（销量 × 价格），因为售价可能随时间变化，\n",
      "# 我们用 books 表的当前价格计算。更准确的做法是用 order_items 的 unit_price。\n",
      "!docker exec pg-learn psql -U postgres -d learn -c \"\n",
      "SELECT b.title, a.name AS author, SUM(s.quantity * b.price) AS 总销售额\n",
      "FROM bookstore.books b\n",
      "JOIN bookstore.authors a ON b.author_id = a.id\n",
      "JOIN bookstore.sales s ON b.id = s.book_id\n",
      "GROUP BY b.title, a.name\n",
      "ORDER BY 总销售额 DESC\n",
      "LIMIT 3;\n",
      "\"\n",
      "\n",
      "print(\"---\")"
    ]
