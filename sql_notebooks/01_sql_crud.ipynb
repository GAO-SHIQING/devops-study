      "---\n",
      "\n",
      "## Day 5：INSERT / SELECT 基础\n",
      "\n",
      "### INSERT：向表中添加数据\n",
      "\n",
      "```sql\n",
      "-- 插入单行\n",
      "INSERT INTO table_name (col1, col2, col3) VALUES (val1, val2, val3);\n",
      "\n",
      "-- 插入多行\n",
      "INSERT INTO table_name (col1, col2) VALUES (v1, v2), (v3, v4), (v5, v6);\n",
      "\n",
      "-- INSERT ... RETURNING：插入后返回数据\n",
      "INSERT INTO table_name (col1) VALUES (val) RETURNING id, col1;\n",
      "```\n",
      "\n",
      "### SELECT：查询数据\n",
      "\n",
      "```sql\n",
      "-- 选择指定列\n",
      "SELECT col1, col2 FROM table_name;\n",
      "\n",
      "-- 选择所有列（不推荐生产用）\n",
      "SELECT * FROM table_name;\n",
      "\n",
      "-- 列别名\n",
      "SELECT col1 AS 别名 FROM table_name;\n",
      "\n",
      "-- 去重\n",
      "SELECT DISTINCT category FROM table_name;\n",
      "\n",
      "-- 表达式\n",
      "SELECT name, price * 1.1 AS tax_included FROM products;\n",
      "```"
    ]
